# Chatly Supabase Environment Configuration
# Copy this file to .env.local and populate with your Supabase Project credentials.
# Do NOT put secret / service_role keys here. Use only the Project URL and Publishable / Anon key.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
